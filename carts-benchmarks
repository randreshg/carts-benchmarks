#!/usr/bin/env bash
################################################################################
# carts-benchmarks - CARTS Benchmark Runner
#
# Uses the Dekk-managed CARTS project command.
################################################################################

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CARTS_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
cd "$CARTS_ROOT"
exec dekk carts benchmarks "$@"
