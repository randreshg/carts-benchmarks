{
  "name": "cgo-single-node",
  "description": "CGO '27 single-node evaluation: currently enabled paper benchmarks across 8/16/32/64 threads at extralarge size, plus a 64-thread timing-counter pass for paper figure regeneration.",
  "steps": [
    {
      "name": "thread-sweep-extralarge",
      "description": "Currently enabled paper benchmarks at extralarge size, 8/16/32/64 threads, single-node. Drives scaling-trends and scaling-results.",
      "benchmarks": [
        "polybench/gemm",
        "polybench/2mm",
        "polybench/3mm",
        "polybench/atax",
        "polybench/bicg",
        "polybench/correlation",
        "polybench/convolution-2d",
        "polybench/convolution-3d",
        "polybench/jacobi2d",
        "kastors-jacobi/jacobi-for",
        "kastors-jacobi/poisson-for",
        "ml-kernels/activations",
        "ml-kernels/batchnorm",
        "ml-kernels/layernorm",
        "ml-kernels/pooling",
        "seissol/volume-integral",
        "specfem3d/stress",
        "specfem3d/velocity",
        "sw4lite/vel4sg-base",
        "stream"
      ],
      "size": "extralarge",
      "threads": "8,16,32,64",
      "nodes": "1",
      "launcher": "local",
      "arts_config": "local.cfg",
      "rdma": false,
      "runs": 15,
      "warmup_runs": 5,
      "perf": false,
      "profile": "profile-none.cfg",
      "timeout": 1800
    },
    {
      "name": "headline-64t-counters",
      "description": "64-thread headline point with perf-stat and ARTS timing counters. Drives speedup-by-strategy and latency-comparison.",
      "benchmarks": [
        "polybench/gemm",
        "polybench/2mm",
        "polybench/3mm",
        "polybench/atax",
        "polybench/bicg",
        "polybench/correlation",
        "polybench/convolution-2d",
        "polybench/convolution-3d",
        "polybench/jacobi2d",
        "kastors-jacobi/jacobi-for",
        "kastors-jacobi/poisson-for",
        "ml-kernels/activations",
        "ml-kernels/batchnorm",
        "ml-kernels/layernorm",
        "ml-kernels/pooling",
        "seissol/volume-integral",
        "specfem3d/stress",
        "specfem3d/velocity",
        "sw4lite/vel4sg-base",
        "stream"
      ],
      "size": "extralarge",
      "threads": "64",
      "nodes": "1",
      "launcher": "local",
      "arts_config": "local.cfg",
      "rdma": false,
      "runs": 15,
      "warmup_runs": 5,
      "perf": true,
      "profile": "profile-timing.cfg",
      "timeout": 1800
    }
  ]
}
