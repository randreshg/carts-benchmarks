{
  "name": "cgo-multinode-gemm",
  "description": "CGO '27 GEMM multi-node case study: strong scaling, communication/time decomposition, and capacity scaling with explicit GEMM dimension overrides.",
  "steps": [
    {
      "name": "strong-scaling-1to16",
      "description": "Fixed extralarge GEMM across 1,2,4,8,16 nodes at 64 threads/node over RDMA.",
      "benchmarks": ["polybench/gemm"],
      "size": "extralarge",
      "threads": "64",
      "nodes": "1,2,4,8,16",
      "launcher": "slurm",
      "rdma": true,
      "compile_args": null,
      "runs": 15,
      "warmup_runs": 5,
      "perf": false,
      "profile": "profile-timing.cfg",
      "timeout": 3600
    },
    {
      "name": "decomposition-1to16",
      "description": "GEMM decomposition rerun with communication counters.",
      "benchmarks": ["polybench/gemm"],
      "size": "extralarge",
      "threads": "64",
      "nodes": "1,2,4,8,16",
      "launcher": "slurm",
      "rdma": true,
      "compile_args": null,
      "runs": 5,
      "perf": false,
      "profile": "profile-comm.cfg",
      "timeout": 3600
    },
    {
