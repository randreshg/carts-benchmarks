{
  "name": "all-enabled-1-to-2-64t-validation",
  "description": "Serial triage gate for every enabled CARTS benchmark: 64 threads, 1-node reference, 2-node baseline, then 2-node distributed. Each job uses a 270 second process timeout plus a 5 minute SLURM wall cap so failures expose compiler/runtime/blocking work before the final megalarge campaign.",
  "steps": [
    {
      "name": "single-node-reference",
      "description": "One-node 64-thread reference. The runner uses TCP for this single-node row.",
      "benchmarks": [
        "kastors-jacobi/jacobi-for",
        "kastors-jacobi/poisson-for",
        "ml-kernels/activations",
        "ml-kernels/batchnorm",
        "ml-kernels/layernorm",
        "ml-kernels/pooling",
        "polybench/2mm",
        "polybench/3mm",
        "polybench/atax",
        "polybench/bicg",
        "polybench/convolution-2d",
        "polybench/convolution-3d",
        "polybench/correlation",
        "polybench/gemm",
        "polybench/jacobi2d",
        "polybench/seidel-2d",
        "seissol/volume-integral",
        "specfem3d/stress",
        "specfem3d/velocity",
        "stream",
        "sw4lite/vel4sg-base"
      ],
      "size": "extralarge",
      "threads": "64",
      "nodes": "1",
      "launcher": "slurm",
      "rdma": true,
      "runs": 1,
      "warmup_runs": 0,
      "perf": false,
      "profile": "profile-none.cfg",
      "timeout": 270
    },
    {
      "name": "two-node-baseline",
      "description": "Two-node 64-thread RDMA baseline without distributed DB ownership.",
      "benchmarks": [
        "kastors-jacobi/jacobi-for",
        "kastors-jacobi/poisson-for",
        "ml-kernels/activations",
        "ml-kernels/batchnorm",
        "ml-kernels/layernorm",
        "ml-kernels/pooling",
        "polybench/2mm",
        "polybench/3mm",
        "polybench/atax",
        "polybench/bicg",
        "polybench/convolution-2d",
        "polybench/convolution-3d",
        "polybench/correlation",
        "polybench/gemm",
        "polybench/jacobi2d",
        "polybench/seidel-2d",
        "seissol/volume-integral",
        "specfem3d/stress",
        "specfem3d/velocity",
        "stream",
        "sw4lite/vel4sg-base"
      ],
      "size": "extralarge",
      "threads": "64",
      "nodes": "2",
      "launcher": "slurm",
      "rdma": true,
      "compile_args": "--no-distributed-db",
      "runs": 1,
      "warmup_runs": 0,
      "perf": false,
      "profile": "profile-none.cfg",
      "timeout": 270
    },
    {
      "name": "two-node-distributed-db",
      "description": "Two-node 64-thread RDMA run with distributed DB ownership and allocation.",
      "benchmarks": [
        "kastors-jacobi/jacobi-for",
        "kastors-jacobi/poisson-for",
        "ml-kernels/activations",
        "ml-kernels/batchnorm",
        "ml-kernels/layernorm",
        "ml-kernels/pooling",
        "polybench/2mm",
        "polybench/3mm",
        "polybench/atax",
        "polybench/bicg",
        "polybench/convolution-2d",
        "polybench/convolution-3d",
        "polybench/correlation",
        "polybench/gemm",
        "polybench/jacobi2d",
        "polybench/seidel-2d",
        "seissol/volume-integral",
        "specfem3d/stress",
        "specfem3d/velocity",
        "stream",
        "sw4lite/vel4sg-base"
      ],
      "size": "extralarge",
      "threads": "64",
      "nodes": "2",
      "launcher": "slurm",
      "rdma": true,
      "compile_args": null,
      "runs": 1,
      "warmup_runs": 0,
      "perf": false,
      "profile": "profile-none.cfg",
      "timeout": 270
    }
  ]
}
