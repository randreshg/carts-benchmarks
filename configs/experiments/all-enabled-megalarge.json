{
  "name": "all-enabled-megalarge",
  "description": "Megalarge single-node-to-multinode evaluation scaffold for every currently enabled CARTS benchmark. Intended for final evaluation after optimization convergence; use --slurm --dry-run for harness validation.",
  "steps": [
    {
      "name": "single-node-reference",
      "description": "One-node megalarge reference for every currently enabled benchmark.",
      "benchmarks": [
        "kastors-jacobi/jacobi-for",
        "kastors-jacobi/poisson-for",
        "ml-kernels/activations",
        "ml-kernels/batchnorm",
        "ml-kernels/layernorm",
        "ml-kernels/pooling",
        "polybench/2mm",
        "polybench/3mm",
        "polybench/atax",
        "polybench/bicg",
        "polybench/convolution-2d",
        "polybench/convolution-3d",
        "polybench/correlation",
        "polybench/gemm",
        "polybench/jacobi2d",
        "seissol/volume-integral",
        "specfem3d/stress",
        "specfem3d/velocity",
        "stream",
        "sw4lite/vel4sg-base"
      ],
      "size": "megalarge",
      "threads": "64",
      "nodes": "1",
      "launcher": "slurm",
      "rdma": true,
      "runs": 1,
      "warmup_runs": 0,
      "perf": false,
      "profile": "profile-none.cfg",
      "timeout": 7200
    },
    {
      "name": "multinode-baseline",
      "description": "Megalarge RDMA node sweep without distributed DB ownership.",
      "benchmarks": [
        "kastors-jacobi/jacobi-for",
        "kastors-jacobi/poisson-for",
        "ml-kernels/activations",
        "ml-kernels/batchnorm",
        "ml-kernels/layernorm",
        "ml-kernels/pooling",
        "polybench/2mm",
        "polybench/3mm",
        "polybench/atax",
        "polybench/bicg",
        "polybench/convolution-2d",
        "polybench/convolution-3d",
        "polybench/correlation",
        "polybench/gemm",
        "polybench/jacobi2d",
        "seissol/volume-integral",
        "specfem3d/stress",
        "specfem3d/velocity",
        "stream",
        "sw4lite/vel4sg-base"
      ],
      "size": "megalarge",
      "threads": "64",
      "nodes": "1,2,4,8",
      "launcher": "slurm",
      "rdma": true,
      "runs": 1,
      "warmup_runs": 0,
      "perf": false,
      "profile": "profile-none.cfg",
      "timeout": 7200
    },
    {
      "name": "multinode-distributed-db",
      "description": "Megalarge RDMA node sweep with distributed DB ownership. The runner strips --distributed-db from the 1-node row unless CARTS_KEEP_DISTRIBUTED_DB_1N=1 is set.",
      "benchmarks": [
        "kastors-jacobi/jacobi-for",
        "kastors-jacobi/poisson-for",
        "ml-kernels/activations",
        "ml-kernels/batchnorm",
        "ml-kernels/layernorm",
        "ml-kernels/pooling",
        "polybench/2mm",
        "polybench/3mm",
        "polybench/atax",
        "polybench/bicg",
        "polybench/convolution-2d",
        "polybench/convolution-3d",
        "polybench/correlation",
        "polybench/gemm",
        "polybench/jacobi2d",
        "seissol/volume-integral",
        "specfem3d/stress",
        "specfem3d/velocity",
        "stream",
        "sw4lite/vel4sg-base"
      ],
      "size": "megalarge",
      "threads": "64",
      "nodes": "1,2,4,8",
      "launcher": "slurm",
      "rdma": true,
      "compile_args": "--distributed-db",
      "runs": 1,
      "warmup_runs": 0,
      "perf": false,
      "profile": "profile-none.cfg",
      "timeout": 7200
    }
  ]
}
