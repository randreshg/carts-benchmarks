{
  "name": "scale-multinode-generated-rdma",
  "description": "RDMA node sweep for generated ARTS kernels with valid distributed checksums. Runs a one-node baseline for the generated set, then strong-scales the distributed DB build from 2 to 64 nodes at 64 threads for gemm and 2mm.",
  "steps": [
    {
      "name": "generated-single-node-baseline",
      "benchmarks": [
        "polybench/gemm",
        "polybench/2mm"
      ],
      "size": "extralarge",
      "threads": "64",
      "nodes": "1",
      "runs": 1,
      "rdma": true,
      "perf": false,
      "timeout": 1200
    },
    {
      "name": "generated-node-sweep-distributed-db",
      "benchmarks": [
        "polybench/gemm",
        "polybench/2mm"
      ],
      "size": "extralarge",
      "threads": "64",
      "nodes": "2,4,8,16,32,64",
      "runs": 1,
      "rdma": true,
      "perf": false,
      "compile_args": "--distributed-db",
      "timeout": 1200
    }
  ]
}
