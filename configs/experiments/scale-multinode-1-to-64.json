{
  "name": "scale-multinode-1-to-64",
  "description": "Multinode 1->64 nodes at 64 threads, extralarge size, baseline + distributed, with ARTS overhead counters at representative points.",
  "steps": [
    {
      "name": "node-sweep-baseline",
      "size": "extralarge",
      "threads": "64",
      "nodes": "1,2,4,8,16,32,64",
      "runs": 1,
      "rdma": true,
      "perf": false,
      "compile_args": "--no-distributed-db",
      "timeout": 1200
    },
    {
      "name": "node-sweep-distributed-db",
      "size": "extralarge",
      "threads": "64",
      "nodes": "1,2,4,8,16,32,64",
      "runs": 1,
      "rdma": true,
      "perf": false,
      "compile_args": null,
      "timeout": 1200
    },
    {
      "name": "overhead-counters-baseline-mid-high",
      "size": "extralarge",
      "threads": "64",
      "nodes": "8,32,64",
      "runs": 1,
      "rdma": true,
      "perf": false,
      "profile": "profile-overhead.cfg",
      "compile_args": "--no-distributed-db",
      "timeout": 1200
    },
    {
      "name": "overhead-counters-ddb-mid-high",
      "size": "extralarge",
      "threads": "64",
      "nodes": "8,32,64",
      "runs": 1,
      "rdma": true,
      "perf": false,
      "profile": "profile-overhead.cfg",
      "compile_args": null,
      "timeout": 1200
    }
  ]
}
